{
  "mcpServers": {
    "milknado": {
      "command": "uv",
      "args": ["run", "milknado-mcp"]
    },
    "code-review-graph": {
      "command": "code-review-graph"
    },
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context=claude-code",
        "--project-from-cwd",
        "--enable-web-dashboard=false",
        "--open-web-dashboard=false"
      ]
    }
  }
}
